# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_API_KEY=token_do_professor_aqui
LLM_BASE_URL=https://url-fornecida-pelo-professor/v1   # endpoint da API do Gemma
LLM_MODEL_NAME=gemma-12b                               # confirme o nome exato com o professor

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2   # modelo local, não precisa de API key

# ─── Paths ───────────────────────────────────────────────────────────────────
DATA_DIR=data/raw
CHROMA_DIR=data/chroma_db
DB_PATH=data/jarvis.db
LOG_FILE=logs/jarvis.log
